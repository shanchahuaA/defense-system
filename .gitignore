# ============================================================
application.yml
.env
.env.*
!.env.example

# ============================================================
# 运行时上传目录
# 教师手写签名、系主任签名、后台上传的 Word 模板都落在这里，
# 一律不入库；目录本身靠 .gitkeep 保留。
#
# 路径必须写全：带斜杠的模式锚定到本文件所在目录，写成 uploads/*
# 只会匹配根目录下的 uploads/，而运行时目录由
# file.upload.path = ${user.dir}/uploads 决定，从 backend/ 启动时
# 落在 backend/uploads/ —— 那样写等于没有排除。
# ============================================================
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/signatures
!backend/uploads/templates
backend/uploads/signatures/*
backend/uploads/templates/*
!backend/uploads/signatures/.gitkeep
!backend/uploads/templates/.gitkeep

# 兜底：从仓库根直接 java -jar 启动时，上传目录会落在根上
/uploads/

# ============================================================
# Python（本仓库带 privacy_scan.py）
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ============================================================
# 日志
# ============================================================
*.log
*.err

# ============================================================
# 压缩包与系统文件
# ============================================================
*.rar
*.zip
*.7z
*.tar.gz
.DS_Store
Thumbs.db
desktop.ini